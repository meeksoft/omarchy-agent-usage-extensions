{
  "schemaVersion": 1,
  "id": "meeksoft.agent-usage-extensions",
  "name": "Agent Usage Extensions",
  "version": "0.1.0",
  "author": "Meeksoft",
  "license": "MIT",
  "description": "Adds GitHub Copilot and GLM Coding Plan quotas to Omarchy's Agents panel.",
  "kinds": [
    "bar-widget"
  ],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Agent Usage Extensions",
    "description": "Omarchy's Agents panel with GitHub Copilot and GLM Coding Plan collectors.",
    "category": "AI",
    "aliases": [
      "agents",
      "model-usage",
      "copilot",
      "glm"
    ],
    "allowMultiple": false,
    "defaults": {
      "providers": {
        "claude": { "enabled": true },
        "codex": { "enabled": true },
        "fireworks": { "enabled": true },
        "copilot": { "enabled": true },
        "glm": { "enabled": true }
      },
      "refreshIntervalSec": 900,
      "syncMode": "Off",
      "syncDir": "",
      "syncFileName": "",
      "syncDeviceId": ""
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 30,
        "max": 3600,
        "step": 30,
        "defaultValue": 900
      },
      {
        "key": "syncMode",
        "type": "enum",
        "label": "Synced aggregation",
        "options": ["Off", "On"],
        "defaultValue": "Off"
      },
      {
        "key": "syncDir",
        "type": "path",
        "label": "Sync folder",
        "defaultValue": ""
      },
      {
        "key": "syncFileName",
        "type": "string",
        "label": "Snapshot file name",
        "defaultValue": ""
      },
      {
        "key": "syncDeviceId",
        "type": "string",
        "label": "Device id",
        "defaultValue": ""
      }
    ]
  },
  "omarchy": {
    "clonedFrom": "omarchy.agents"
  }
}
