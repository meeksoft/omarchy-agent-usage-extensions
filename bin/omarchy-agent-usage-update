#!/bin/bash

# User-owned extension of Omarchy's stock updater. The packaged updater keeps
# managing its built-in collectors; this wrapper adds the extras afterward.

set -uo pipefail

script_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$script_root/../lib/runtime.sh"

# Every agent this wrapper adds, in the order their records are written. The
# value names the interpreter: "runtime" for a collector that needs the Copilot
# SDK virtualenv, "direct" for one that runs on the system Python. Adding an
# agent is a line here plus bin/omarchy-agent-usage-<id>; nothing below knows
# any agent by name.
agent_ids=(copilot glm grok)
declare -A agent_runner=([copilot]=runtime [glm]=direct [grok]=direct)

stock_updater="${OMARCHY_PATH:-/usr/share/omarchy}/bin/omarchy-agent-usage-update"
runtime_python="$(agent_usage_python)"
usage_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/usage"

"$stock_updater" "$@"
stock_status=$?

declare -A include
for id in "${agent_ids[@]}"; do include[$id]=true; done

explicit_agents=()
skip_next=false
for arg in "$@"; do
  if $skip_next; then
    [[ -n ${include[$arg]:-} ]] && include[$arg]=false
    skip_next=false
    continue
  fi
  case "$arg" in
    --except) skip_next=true ;;
    --force | --limits-only) ;;
    *) explicit_agents+=("$arg") ;;
  esac
done

# Naming agents explicitly restricts the run to them, so start from nothing.
if (( ${#explicit_agents[@]} > 0 )); then
  for id in "${agent_ids[@]}"; do include[$id]=false; done
  for agent in "${explicit_agents[@]}"; do
    [[ -n ${include[$agent]:-} ]] && include[$agent]=true
  done
fi

collect_status=0
for id in "${agent_ids[@]}"; do
  ${include[$id]} || continue
  collector="$script_root/omarchy-agent-usage-$id"
  mkdir -p "$usage_dir"

  if [[ ${agent_runner[$id]} == runtime ]]; then
    if [[ ! -x $runtime_python ]]; then
      echo "omarchy-agent-usage-update: $id runtime missing; see plugin README" >&2
      collect_status=1
      continue
    fi
    command=("$runtime_python" "$collector")
  else
    command=("$collector")
  fi

  if record=$(timeout 25 "${command[@]}") && jq -e . >/dev/null 2>&1 <<<"$record"; then
    tmp=$(mktemp "$usage_dir/.$id.XXXXXX")
    printf '%s\n' "$record" >"$tmp"
    mv "$tmp" "$usage_dir/$id.json"
  else
    echo "omarchy-agent-usage-update: $id collector failed" >&2
    collect_status=1
  fi
done

(( stock_status == 0 && collect_status == 0 ))
