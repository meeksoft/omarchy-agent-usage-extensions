#!/usr/bin/env python3
"""Emit an Omarchy Agent Panel record for a Z.ai GLM Coding Plan."""

from __future__ import annotations

import json
import os
import ssl
import sys
import urllib.error
import urllib.request
from dataclasses import dataclass
from datetime import UTC, datetime
from pathlib import Path
from typing import Any
from urllib.parse import urlparse

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from agent_credentials import (  # noqa: E402
    agent_config_path,
    agent_sources,
    first_present,
    merged_values,
    opencode_family_keys,
)


ALLOWED_HOSTS = {"api.z.ai", "open.bigmodel.cn", "dev.bigmodel.cn"}
DEFAULT_BASE_URL = "https://api.z.ai/api/anthropic"
# Z.ai names only, most specific first, so a key meant for the coding plan
# always outranks a generic platform key. ANTHROPIC_AUTH_TOKEN is not here: it
# is Anthropic's name, and credentials() admits it only where it is plainly a
# GLM key.
TOKEN_KEYS = ("ZAI_CODING_PLAN_API_KEY", "ZAI_API_KEY", "ZHIPU_API_KEY", "ZHIPUAI_API_KEY")
# The provider ids opencode and kilo give Z.ai, most specific first. The
# zhipuai ones are BigModel China's.
PROVIDER_IDS = ("zai-coding-plan", "zhipuai-coding-plan", "zai", "zhipuai")
NOT_FOUND_HELP = (
    "No Z.ai key found in the environment, ~/.config/omarchy/agents/glm.json, Claude Code settings, "
    "~/.config/claude-profiles/glm.env, opencode, or kilo. Set ZAI_CODING_PLAN_API_KEY in "
    "~/.config/omarchy/agents/glm.json, or connect Z.ai in opencode or kilo."
)


@dataclass(frozen=True)
class Credential:
    token: str
    base_url: str
    source: str


def base_record() -> dict[str, Any]:
    return {
        "schemaVersion": 1,
        "id": "glm",
        "name": "GLM Coding Plan",
        "updatedAt": datetime.now(UTC).isoformat(),
        "ready": False,
        "hasLocalStats": False,
        "hasPromptStats": False,
        "tierLabel": "",
        "usageStatusText": "GLM quota unavailable",
        "authHelpText": NOT_FOUND_HELP,
        "limits": [],
        "todayPrompts": 0,
        "todaySessions": 0,
        "todayTotalTokens": 0,
        "todayTokensByModel": {},
        "recentDays": [],
        "totalPrompts": 0,
        "totalSessions": 0,
        "activeDays": 0,
        "activeDates": [],
        "modelUsage": {},
    }


def supported(url: str) -> bool:
    parsed = urlparse(url)
    return parsed.scheme == "https" and parsed.hostname in ALLOWED_HOSTS


def profile_path() -> Path:
    return Path.home() / ".config/claude-profiles/glm.env"


def credentials() -> Credential | None:
    """The key to query and where it came from, or None when there is none.

    1. A key under a Z.ai name, from the environment, glm.json, Claude Code's
       settings, or the GLM profile, in that order.
    2. The key opencode or kilo would send to a Z.ai provider.
    3. ANTHROPIC_AUTH_TOKEN where it is plainly a GLM key. The name is
       Anthropic's and the default endpoint is Z.ai's, so it counts only in a
       file kept for GLM with no other endpoint beside it, or next to a Z.ai
       base URL in the same source — never on the strength of a base URL set
       somewhere else.
    """
    config_dir = Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude"))
    sources = agent_sources("glm", (
        config_dir / "settings.json",
        config_dir / "settings.local.json",
        profile_path(),
    ))
    fallback = next((s.values["ANTHROPIC_BASE_URL"] for s in sources
                     if supported(s.values.get("ANTHROPIC_BASE_URL", ""))), DEFAULT_BASE_URL)

    for source in sources:
        if token := first_present(source.values, TOKEN_KEYS):
            return Credential(token, source.values.get("ANTHROPIC_BASE_URL") or fallback, source.label)

    if found := next(opencode_family_keys(PROVIDER_IDS, merged_values(sources)), None):
        if supported(found.base_url):
            base_url = found.base_url
        else:
            base_url = "https://open.bigmodel.cn" if found.provider_id.startswith("zhipuai") else "https://api.z.ai"
        return Credential(found.key, base_url, found.source)

    glm_files = {agent_config_path("glm"), profile_path()}
    for source in sources:
        token = source.values.get("ANTHROPIC_AUTH_TOKEN")
        own = source.values.get("ANTHROPIC_BASE_URL", "")
        if token and (supported(own) or (not own and source.path in glm_files)):
            return Credential(token, own or DEFAULT_BASE_URL, source.label)
    return None


def percentage(item: dict[str, Any]) -> float | None:
    raw = item.get("percentage")
    if isinstance(raw, (int, float)):
        return max(0.0, min(1.0, float(raw) / 100.0))
    current, total = item.get("currentValue"), item.get("usage")
    if isinstance(current, (int, float)) and isinstance(total, (int, float)) and total > 0:
        return max(0.0, min(1.0, float(current) / float(total)))
    return None


def reset_time(item: dict[str, Any]) -> str:
    for key in ("nextResetTime", "resetTime", "resetsAt", "resetAt"):
        value = item.get(key)
        if isinstance(value, (int, float)):
            seconds = float(value) / 1000.0 if value > 10_000_000_000 else float(value)
            try:
                return datetime.fromtimestamp(seconds, UTC).isoformat()
            except (OverflowError, OSError, ValueError):
                pass
        if isinstance(value, str) and value:
            return value
    return ""


def limit_label(item: dict[str, Any]) -> str:
    kind = str(item.get("type", "")).upper()
    unit, number = item.get("unit"), item.get("number")
    if unit == 3:
        return f"{number or 5}-hour usage"
    if unit == 6:
        return "Weekly usage" if number in (None, 1) else f"{number}-week usage"
    if kind == "TIME_LIMIT":
        return "Monthly MCP usage"
    if kind == "CREDIT_LIMIT":
        return "Coding-plan credits"
    return "Coding-plan usage"


def collect() -> dict[str, Any]:
    record = base_record()
    credential = credentials()
    if credential is None:
        return record
    if not supported(credential.base_url):
        record["authHelpText"] = f"ANTHROPIC_BASE_URL in {credential.source} is not a supported Z.ai endpoint."
        return record

    endpoint = f"https://{urlparse(credential.base_url).hostname}/api/monitor/usage/quota/limit"
    request = urllib.request.Request(
        endpoint,
        headers={
            "Authorization": credential.token,
            "Accept-Language": "en-US,en",
            "Content-Type": "application/json",
            "User-Agent": "omarchy-agent-usage-glm/1",
        },
    )
    try:
        context = ssl.create_default_context()
        with urllib.request.urlopen(request, timeout=15, context=context) as response:
            payload = json.load(response)
    except urllib.error.HTTPError as exc:
        record["authHelpText"] = f"Z.ai rejected the key from {credential.source} (HTTP {exc.code})."
        return record
    except (urllib.error.URLError, TimeoutError, ValueError) as exc:
        record["authHelpText"] = f"Z.ai quota request failed: {type(exc).__name__}."
        return record

    data = payload.get("data", payload) if isinstance(payload, dict) else {}
    raw_limits = data.get("limits", []) if isinstance(data, dict) else []
    limits = []
    for item in raw_limits if isinstance(raw_limits, list) else []:
        if not isinstance(item, dict):
            continue
        used = percentage(item)
        if used is None:
            continue
        limits.append({"label": limit_label(item), "percent": used, "resetsAt": reset_time(item)})

    level = data.get("level", "") if isinstance(data, dict) else ""
    record["tierLabel"] = f"GLM {str(level).capitalize()}" if level else "GLM Coding Plan"
    record["limits"] = limits
    record["ready"] = bool(limits)
    record["usageStatusText"] = "" if limits else "No GLM quota limits returned"
    record["authHelpText"] = "" if limits else "The key is valid, but no usable coding-plan limits were returned."
    return record


if __name__ == "__main__":
    print(json.dumps(collect(), separators=(",", ":")))
